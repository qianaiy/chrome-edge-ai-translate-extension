{
  "name": "chrome-edge-ai-translate-extension",
  "version": "1.7.7",
  "private": true,
  "type": "module",
  "description": "Chrome/Edge AI translation extension with a reusable translation core library.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:edge": "node scripts/smoke.mjs --edge",
    "smoke:all": "node scripts/smoke.mjs && node scripts/smoke.mjs --edge",
    "regress": "node scripts/browser-regress.mjs",
    "regress:edge": "node scripts/browser-regress.mjs --edge",
    "regress:all": "node scripts/browser-regress.mjs && node scripts/browser-regress.mjs --edge",
    "lint:secrets": "node scripts/secret-scan.mjs",
    "typeset": "node scripts/manga-typeset-check.mjs",
    "typeset:edge": "node scripts/manga-typeset-check.mjs --edge",
    "typeset:all": "node scripts/manga-typeset-check.mjs && node scripts/manga-typeset-check.mjs --edge",
    "samples:make": "python scripts/make-real-samples.py",
    "typeset:jp": "node scripts/manga-typeset-check.mjs",
    "real": "node scripts/manga-real-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}